# Auth server signing secret for id_tokens (only auth_server uses this)
ID_SECRET=change-me-identity-secret-min-32-chars

# App registration: Chat Agent (confidential client)
CHAT_AGENT_CLIENT_ID=chat-agent
CHAT_AGENT_CLIENT_SECRET=change-me-chat-agent-secret-min-32

# App registration: Accounts Service (resource API)
ACCOUNTS_SERVICE_CLIENT_ID=accounts-service
ACCOUNTS_SERVICE_CLIENT_SECRET=change-me-accounts-service-secret-min32


# === Choose one LLM provider, and remove the rest below ===

# OpenAI configuration
OPENAI_API_KEY=...
CHAT_AGENT_MODEL=openai/gpt-4o-mini

# Anthropic configuration
# ANTHROPIC_API_KEY=...
# CHAT_AGENT_MODEL=claude-3-haiku-20240307
